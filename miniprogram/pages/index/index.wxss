.page {
  padding: 32rpx;
}
.hero {
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #07c160, #10d98b);
  color: #fff;
  margin-bottom: 32rpx;
}
.hero-kicker {
  font-size: 22rpx;
  opacity: 0.86;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2a25;
}
.section-note {
  font-size: 22rpx;
  color: #98a09c;
}
.content-head {
  margin-top: 36rpx;
}
.tool-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.tool-card {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-radius: 22rpx;
}
.tool-card:active {
  transform: scale(0.985);
}
.tool-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #176b50;
}
.tool-info {
  flex: 1;
  margin-left: 24rpx;
}
.tool-name {
  font-size: 30rpx;
  font-weight: 650;
  color: #1f2d28;
}
.tool-desc {
  margin-top: 7rpx;
  font-size: 23rpx;
  color: #6e7773;
}
.tool-arrow {
  font-size: 42rpx;
  color: #7c8882;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: 48%;
  box-sizing: border-box;
  padding: 40rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  transition: transform 0.15s ease;
}
.card:active {
  transform: scale(0.97);
}
.card-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.card-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}
.footer {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}
