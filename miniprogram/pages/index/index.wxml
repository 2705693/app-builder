<view class="page">
  <view class="hero">
    <view class="hero-kicker">简单、实用、随手可用</view>
    <view class="hero-title">一链取影</view>
    <view class="hero-sub">文件整理 · 每日计划 · 照片清单</view>
  </view>

  <view class="section-head">
    <view class="section-title">常用工具</view>
    <view class="section-note">部分工具数据保存在本机</view>
  </view>
  <view class="tool-list">
    <view
      class="tool-card"
      wx:for="{{tools}}"
      wx:key="id"
      style="background: {{item.color}}"
      data-id="{{item.id}}"
      bindtap="onTapTool"
    >
      <view class="tool-icon">{{item.icon}}</view>
      <view class="tool-info">
        <view class="tool-name">{{item.name}}</view>
        <view class="tool-desc">{{item.desc}}</view>
      </view>
      <view class="tool-arrow">›</view>
    </view>
  </view>

  <view class="section-head content-head">
    <view class="section-title">使用指南</view>
    <view class="section-note">图文和视频分开</view>
  </view>
  <view class="grid">
    <view
      class="card"
      wx:for="{{categories}}"
      wx:key="id"
      style="background: {{item.color}}"
      data-id="{{item.id}}"
      bindtap="onTapCategory"
    >
      <view class="card-icon">{{item.icon}}</view>
      <view class="card-name">{{item.name}}</view>
      <view class="card-count">{{item.items.length}} 篇内容</view>
    </view>
  </view>

  <view class="footer">无需微信授权登录；使用编号用于额度管理</view>
</view>
