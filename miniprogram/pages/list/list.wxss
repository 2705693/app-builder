.page {
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  color: #999;
  padding: 8rpx 8rpx 20rpx;
}
.item-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.cover-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}
.item-cover {
  width: 220rpx;
  height: 220rpx;
}
.play-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}
.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.item-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #07c160;
}
.item-summary {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #777;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.item-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}
.item-tag {
  font-size: 20rpx;
  color: #555;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.item-arrow {
  font-size: 24rpx;
  color: #07c160;
}