<view class="page">
  <view class="section-title">{{categoryName}}（{{items.length}}）</view>

  <view
    class="item-card"
    wx:for="{{items}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onTapItem"
  >
    <view class="cover-wrap">
      <image class="item-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="play-badge" wx:if="{{item.video}}">▶</view>
    </view>
    <view class="item-body">
      <view class="item-title">{{item.title}}</view>
      <view class="item-sub">{{item.subtitle}}</view>
      <view class="item-summary">{{item.summary}}</view>
      <view class="item-footer">
        <view class="item-tag" style="background: {{color}}">{{item.tag}}</view>
        <view class="item-arrow" wx:if="{{item.video}}">{{item.video.duration}} ›</view>
        <view class="item-arrow" wx:else>阅读 ›</view>
      </view>
    </view>
  </view>
</view>