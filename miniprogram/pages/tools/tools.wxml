<view class="page">
  <view class="intro">
    <view class="intro-title">{{title}}</view>
    <view class="intro-sub" wx:if="{{type === 'filename'}}">统一文件名称，查找和管理更方便</view>
    <view class="intro-sub" wx:elif="{{type === 'plan'}}">每天只安排三件重要的事</view>
    <view class="intro-sub" wx:else>按清单逐项整理手机相册</view>
  </view>

  <view class="panel" wx:if="{{type === 'filename'}}">
    <view class="label">日期</view>
    <input class="input" value="{{date}}" data-field="date" bindinput="onFieldInput" maxlength="8" />
    <view class="label">文件主题</view>
    <input class="input" placeholder="例如：旅行计划" value="{{topic}}" data-field="topic" bindinput="onFieldInput" maxlength="30" />
    <view class="label">版本</view>
    <input class="input" value="{{version}}" data-field="version" bindinput="onFieldInput" maxlength="10" />
    <button class="primary" bindtap="generateFilename">生成文件名</button>
    <view class="result" wx:if="{{filenameResult}}">
      <text selectable>{{filenameResult}}</text>
      <button class="copy" bindtap="copyFilename">复制</button>
    </view>
  </view>

  <view class="panel" wx:elif="{{type === 'plan'}}">
    <block wx:for="{{tasks}}" wx:key="index">
      <view class="label">任务 {{index + 1}}</view>
      <input class="input" placeholder="输入今天要完成的事情" value="{{item}}" data-index="{{index}}" bindinput="onTaskInput" maxlength="40" />
    </block>
    <button class="primary" bindtap="savePlan">保存今日计划</button>
    <view class="saved" wx:if="{{savedPlan.length}}">
      <view class="saved-title">已保存</view>
      <view class="saved-item" wx:for="{{savedPlan}}" wx:key="index">{{index + 1}}. {{item}}</view>
    </view>
  </view>

  <view class="panel" wx:else>
    <view
      class="check-row {{item.done ? 'done' : ''}}"
      wx:for="{{photoSteps}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="togglePhotoStep"
    >
      <view class="checkbox">{{item.done ? '✓' : ''}}</view>
      <view class="check-text">{{item.text}}</view>
    </view>
    <button class="secondary" bindtap="resetPhotoSteps">重新开始</button>
  </view>

  <view class="privacy">本页数据仅保存在你的设备中</view>
</view>
