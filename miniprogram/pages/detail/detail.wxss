.page {
  padding-bottom: 60rpx;
}
.cover {
  width: 100%;
  height: 400rpx;
  display: block;
}
.video-badge {
  position: absolute;
  top: 340rpx;
  left: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.content-card {
  margin: -60rpx 24rpx 0;
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.title-row {
  margin-bottom: 16rpx;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #07c160;
  background: #e8f7ef;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.4;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}
.video-section {
  margin-top: 28rpx;
}
.video-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.video-duration {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}
.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #000;
}
.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 28rpx 0;
}
.body {
  font-size: 30rpx;
  color: #444;
  line-height: 1.9;
  white-space: pre-wrap;
}
.tip {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  margin-top: 40rpx;
}
.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: #999;
  font-size: 28rpx;
}