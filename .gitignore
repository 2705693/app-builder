# 本仓库仅发布 Android APP；根目录采用白名单，防止误传小程序、服务器和私人资料
/*
!/.github/
!/.github/**
!/android_app/
!/android_app/**
!/.gitignore
!/README.md

# 敏感凭据与私密文件（严禁上传）
*Cookie.txt
*cookie.txt
*.key
*.pem

# 截图与大体积多媒体文件
screenshot*.png
devtools*.png
*.mp4

# 本地大型大模型与工具目录
LocalLlmHub/
.obsidian/
preview.log

# Flutter / Dart 构建产物与缓存
android_app/.dart_tool/
android_app/build/
android_app/.flutter-plugins
android_app/.flutter-plugin-dependencies
android_app/.packages
android_app/android/local.properties
android_app/android/.gradle/
__pycache__/
*.pyc

# 系统临时文件
.DS_Store
Thumbs.db
